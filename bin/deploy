#!/usr/bin/env bash
# Deploy master to thereish.app. One command, from a clean master.
#
#   bin/deploy
#
# Fetches master on the VPS, rebuilds the release image from the same Dockerfile
# used on the Mac, migrates, restarts, and does not return until the deployed
# page answers over TLS.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../deploy/env.sh"
COMPOSE="docker compose -f docker-compose.app.yml"

# Without the fetch this compares against a possibly stale remote-tracking ref,
# and the deploy fails later on the server with a much less obvious message.
git fetch --quiet origin

LOCAL_HEAD="$(git rev-parse master)"
if [ "${LOCAL_HEAD}" != "$(git rev-parse origin/master)" ]; then
  echo "master and origin/master differ. Push first — the server deploys from origin." >&2
  exit 1
fi

# A dirty tree is a warning, not a failure: design docs are edited in this repo
# alongside the build, and none of it reaches the server anyway — the deploy is
# origin/master and nothing else.
if [ -n "$(git status --porcelain)" ]; then
  echo "Note: uncommitted changes here will not be deployed."
fi

# A warning rather than a failure, for the same reason the dirty-tree check is:
# the game runs without keys, it just degrades to silence or static pools. But
# an evening where the Assayer has no verdict or the Author cannot write is a
# missing line in a file, not a design, and this is the last moment anyone is looking.
VOICE_PROVIDER=$(grep -E '^[[:space:]]*voice:[[:space:]]*\[' -A 5 "${SCRIPT_DIR}/../config/config.exs" | grep -v '^[[:space:]]*#' | grep -o 'provider:[[:space:]]*MeaningGame\.Steward\.[A-Za-z0-9_]*' | head -n1 | sed 's/.*\.//')

MISSING_KEYS=$(ssh "${SERVER}" "
  grep -q '^GEMINI_API_KEY=.' ${APP_DIR}/.env || echo 'GEMINI_API_KEY'
  grep -q '^ANTHROPIC_API_KEY=.' ${APP_DIR}/.env || echo 'ANTHROPIC_API_KEY'
  grep -q '^MUREKA_API_KEY=.' ${APP_DIR}/.env || echo 'MUREKA_API_KEY'
  grep -q '^HUME_API_KEY=.' ${APP_DIR}/.env || echo 'HUME_API_KEY'
  grep -q '^HUME_SECRET_KEY=.' ${APP_DIR}/.env || echo 'HUME_SECRET_KEY'
  grep -q '^ELEVENLABS_API_KEY=.' ${APP_DIR}/.env || echo 'ELEVENLABS_API_KEY'
")

if echo "${MISSING_KEYS}" | grep -q 'GEMINI_API_KEY'; then
  echo "Note: no GEMINI_API_KEY in ${APP_DIR}/.env — the Assayer will grade nothing."
  echo "      See docs/deploy.md, \"The Assayer's key\"."
fi

if echo "${MISSING_KEYS}" | grep -q 'ANTHROPIC_API_KEY'; then
  echo "Note: no ANTHROPIC_API_KEY in ${APP_DIR}/.env — the Author cannot write for Gives."
  echo "      See docs/deploy.md, \"The Author's key\"."
fi

if echo "${MISSING_KEYS}" | grep -q 'MUREKA_API_KEY'; then
  echo "Note: no MUREKA_API_KEY in ${APP_DIR}/.env — every Page will have only the house loop."
  echo "      See docs/deploy.md, \"Foley's keys\"."
fi

if [ "${VOICE_PROVIDER}" = "ElevenLabs" ]; then
  VOICE_KEYS=("ELEVENLABS_API_KEY")
else
  VOICE_KEYS=("HUME_API_KEY" "HUME_SECRET_KEY")
fi

for key in "${VOICE_KEYS[@]}"; do
  if echo "${MISSING_KEYS}" | grep -q "${key}"; then
    echo "Note: no ${key} in ${APP_DIR}/.env — the voice switch will do nothing."
    echo "      See docs/deploy.md, \"Foley's keys\"."
  fi
done

echo "== Deploying ${LOCAL_HEAD:0:7} to ${HOST}"
ssh "${SERVER}" bash -s <<REMOTE
set -euo pipefail
cd "${APP_DIR}"
git fetch --quiet origin
git checkout --quiet master
git reset --quiet --hard origin/master
test "\$(git rev-parse HEAD)" = "${LOCAL_HEAD}" || { echo "server HEAD is not ${LOCAL_HEAD}" >&2; exit 1; }

${COMPOSE} build
# -T and </dev/null both matter: docker compose run reads stdin, and stdin here
# is the rest of this script arriving over ssh.
${COMPOSE} run --rm -T app /app/bin/migrate </dev/null
${COMPOSE} up -d
REMOTE

echo "== Waiting for ${HOST} to answer"
for _ in $(seq 1 30); do
  # Gated on the marker attribute rather than on the page's prose, which is
  # there to be reworded. MeaningGameWeb.CheckLive names this as load-bearing.
  #
  # -s not -sS: a 502 while the old container is still going down is expected
  # here, and printing it every two seconds makes a normal deploy look broken.
  if curl -fs --max-time 5 "https://${HOST}/check" | grep -q 'data-check="socket"'; then
    echo "== Live: https://${HOST}/"
    exit 0
  fi
  sleep 2
done

echo "Deployed, but https://${HOST}/check did not serve the check page within 60s." >&2
echo "Logs: ssh ${SERVER} 'cd ${APP_DIR} && ${COMPOSE} logs --tail=50 app'" >&2
exit 1

#!/usr/bin/env bash
# One-time setup of thereish.app on the VPS: checkout, Postgres role and
# database, pg_hba rule, .env, Apache vhost, TLS certificate.
#
# Idempotent — safe to re-run. Routine deploys are bin/deploy.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../deploy/env.sh"

echo "== Ensuring the checkout at ${APP_DIR}"
ssh "${SERVER}" bash -s <<REMOTE
set -euo pipefail
if [ ! -d "${APP_DIR}/.git" ]; then
  sudo install -d -o "\$(id -un)" -g "\$(id -gn)" "${APP_DIR}"
  git clone "${REPO}" "${APP_DIR}"
else
  git -C "${APP_DIR}" fetch --quiet origin
  git -C "${APP_DIR}" checkout --quiet master
  git -C "${APP_DIR}" reset --quiet --hard origin/master
fi
REMOTE

echo "== Running deploy/provision.sh on the server"
ssh -t "${SERVER}" "cd ${APP_DIR} && bash deploy/provision.sh"

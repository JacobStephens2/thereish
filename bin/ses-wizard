#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

# shellcheck disable=SC2034
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

# Amazon SES wizard for Thereish:
#
#   va bash -c bin/ses-wizard
#   bin/ses-wizard
#
# Walks through the 8 stages required to provision Amazon SES for thereish.app:
# 1. IAM identity with SES send permissions & access key
# 2. SES domain identity for thereish.app, reading back Easy DKIM CNAMEs
# 3. Custom MAIL FROM subdomain (send.thereish.app), reading back MX and TXT
# 4. _dmarc.thereish.app at p=none with rua= and cross-domain report-authorisation
# 5. Idempotent DNS record publishing through Porkbun's API with va key
# 6. Waiting for identity verification
# 7. Requesting production access with use-case description
# 8. Pushing credentials and notice addresses to server through bin/keys-to-server
#
# The wizard never prints a secret.

TOTAL_STAGES=8

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=deploy/env.sh
source "${SCRIPT_DIR}/../deploy/env.sh"
DOMAIN="${HOST:-thereish.app}"
AWS_REGION="${AWS_REGION:-us-east-1}"
MAIL_FROM_SUBDOMAIN="send"
PORKBUN_API_BASE="https://api.porkbun.com/api/json/v3"

# Porkbun API caller
porkbun_call() {
  local endpoint="$1" body="$2"
  local merged_body
  if command -v jq >/dev/null 2>&1; then
    merged_body=$(printf '%s' "$body" | jq -c \
      --arg apikey "${PORKBUN_API_KEY}" \
      --arg secretapikey "${PORKBUN_SECRET_API_KEY}" \
      '. + {apikey: $apikey, secretapikey: $secretapikey}' 2>/dev/null || true)
  fi
  curl -sS -X POST "${PORKBUN_API_BASE}/${endpoint}" \
    -H "Content-Type: application/json" \
    -H "X-API-Key: ${PORKBUN_API_KEY}" \
    -H "X-Secret-API-Key: ${PORKBUN_SECRET_API_KEY}" \
    -d "${merged_body:-$body}" 2>/dev/null || true
}

# Publish a DNS record to Porkbun idempotently
# Returns 0 on success/already exists/recorded as skipped (never crashes wizard under set -e).
porkbun_publish_record_idempotent() {
  local domain="$1" subdomain="$2" type="$3" content="$4" prio="${5:-0}"
  local existing_records="$6"

  # Normalize content: strip quotes and trailing dot for hostnames
  content="${content%\"}"
  content="${content#\"}"
  if [[ "$type" == "CNAME" ]]; then
    content="${content%.}"
  elif [[ "$type" == "MX" ]]; then
    # Strip any leading priority number like "10 feedback-smtp..."
    content="${content#"${content%%[a-zA-Z]*}"}"
    content="${content%.}"
  fi

  local expected_name
  if [[ -z "$subdomain" || "$subdomain" == "@" ]]; then
    expected_name="${domain}"
  else
    expected_name="${subdomain}.${domain}"
  fi

  if [[ -z "$subdomain" && "$type" == "CNAME" ]]; then
    warn "Cannot publish CNAME with empty subdomain on ${domain}"
    SKIPPED+=("DNS record CNAME ${expected_name} (empty subdomain)")
    return 0
  fi

  local existing_id=""
  if command -v jq >/dev/null 2>&1; then
    existing_id=$(printf '%s' "$existing_records" | jq -r \
      --arg type "$type" \
      --arg name "$expected_name" \
      --arg content "$content" \
      '.records[]? | select(
        (.type | ascii_upcase) == ($type | ascii_upcase) and
        (.name | ascii_downcase) == ($name | ascii_downcase) and
        ((.content | gsub("^\"|\"$"; "") | rtrimstr(".")) == ($content | gsub("^\"|\"$"; "") | rtrimstr(".")))
      ) | .id' 2>/dev/null | head -n1 || true)
  fi

  if [[ -n "$existing_id" ]]; then
    say "  ${GREEN}✓${RESET} ${type} ${expected_name} already present in Porkbun DNS (id: ${existing_id})"
    return 0
  fi

  # In DNS, a CNAME record cannot coexist with any other record type at the same host (RFC 1912 §2.4).
  # If we are publishing an MX or TXT record and a CNAME exists for that exact host, Porkbun will
  # reject the create call ("Create error: We were unable to create the DNS record").
  # Similarly, if publishing CNAME and another record exists, it must be removed.
  if command -v jq >/dev/null 2>&1; then
    local conflicting_cnames
    if [[ "$type" != "CNAME" ]]; then
      conflicting_cnames=$(printf '%s' "$existing_records" | jq -r \
        --arg name "$expected_name" \
        '.records[]? | select(
          (.name | ascii_downcase) == ($name | ascii_downcase) and
          (.type | ascii_upcase) == "CNAME"
        ) | .id' 2>/dev/null || true)
    else
      conflicting_cnames=$(printf '%s' "$existing_records" | jq -r \
        --arg name "$expected_name" \
        '.records[]? | select(
          (.name | ascii_downcase) == ($name | ascii_downcase) and
          (.type | ascii_upcase) != "CNAME"
        ) | .id' 2>/dev/null || true)
    fi

    if [[ -n "$conflicting_cnames" ]]; then
      while IFS= read -r conflict_id; do
        [[ -z "$conflict_id" ]] && continue
        say "  ${YELLOW}Notice: Found conflicting record for ${expected_name} (id: ${conflict_id}). Deleting to allow ${type}...${RESET}"
        local del_res del_status
        del_res=$(porkbun_call "dns/delete/${domain}/${conflict_id}" "{}")
        del_status=$(printf '%s' "$del_res" | grep -o '"status":"[^"]*"' | cut -d'"' -f4 || true)
        if [[ "$del_status" == "SUCCESS" ]]; then
          say "  ${GREEN}✓ Deleted conflicting record (id: ${conflict_id})${RESET}"
        else
          warn "Could not delete conflicting record (id: ${conflict_id}): ${del_res}"
        fi
      done <<< "$conflicting_cnames"
    fi
  fi

  local payload
  if command -v jq >/dev/null 2>&1; then
    payload=$(jq -n \
      --arg name "$subdomain" \
      --arg type "$type" \
      --arg content "$content" \
      --argjson ttl 600 \
      --argjson prio "$prio" \
      '{name: $name, type: $type, content: $content, ttl: $ttl, prio: $prio}')
  else
    payload="{\"name\":\"${subdomain}\",\"type\":\"${type}\",\"content\":\"${content}\",\"ttl\":600,\"prio\":${prio}}"
  fi

  local res status msg new_id
  res=$(porkbun_call "dns/create/${domain}" "$payload")
  status=$(printf '%s' "$res" | grep -o '"status":"[^"]*"' | cut -d'"' -f4 || true)

  if [[ "$status" == "SUCCESS" ]]; then
    new_id=$(printf '%s' "$res" | grep -o '"id":[^,}]*' | head -n1 | cut -d':' -f2 | tr -d ' "' || true)
    say "  ${GREEN}✓ published${RESET} ${type} ${expected_name} → ${content} (id: ${new_id})"
    return 0
  else
    msg=$(printf '%s' "$res" | grep -o '"message":"[^"]*"' | cut -d'"' -f4 || true)
    warn "Failed to publish ${type} ${expected_name}: ${msg:-unknown error}"
    if [[ -n "$res" && "$res" != *"\"message\""* ]]; then
      say "  ${DIM}API response: ${res}${RESET}"
    fi
    SKIPPED+=("DNS record ${type} ${expected_name} → ${content}")
    say "  ${YELLOW}You can publish this record manually in Porkbun DNS Console:${RESET}"
    say "    Type:     ${type}"
    say "    Host:     ${subdomain}"
    say "    Answer:   ${content}"
    if [[ "$type" == "MX" ]]; then
      say "    Priority: ${prio}"
    fi
    say "    TTL:      600"
    return 0
  fi
}

# Publish a TXT record to Cloudflare idempotently if token is available.
# Returns 0 on success/already exists, 1 if no token or publication failed.
cloudflare_publish_txt_idempotent() {
  local domain="$1" subdomain="$2" content="$3"
  local token="${CLOUDFLARE_EDIT_ZONES_TOKEN:-${CLOUDFLARE_API_TOKEN:-}}"
  [[ -z "$token" ]] && return 1

  command -v jq >/dev/null 2>&1 || return 1

  say "Found Cloudflare API token. Checking Cloudflare DNS for ${domain}..."
  local zone_id
  zone_id=$(curl -sS -X GET "https://api.cloudflare.com/client/v4/zones?name=${domain}" \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" 2>/dev/null | jq -r '.result[0].id // empty' 2>/dev/null || true)

  if [[ -z "$zone_id" ]]; then
    warn "Could not resolve Cloudflare zone ID for ${domain} with the provided token."
    return 1
  fi

  local full_name="${subdomain}.${domain}"
  local existing_id
  existing_id=$(curl -sS -X GET "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?type=TXT&name=${full_name}" \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" 2>/dev/null | jq -r '.result[0].id // empty' 2>/dev/null || true)

  if [[ -n "$existing_id" ]]; then
    say "  ${GREEN}✓ TXT ${full_name} already present in Cloudflare DNS (id: ${existing_id})${RESET}"
    return 0
  fi

  say "Publishing report-authorisation record on Cloudflare (${domain})..."
  local payload res success new_id
  payload=$(jq -n \
    --arg name "${subdomain}" \
    --arg content "${content}" \
    '{type: "TXT", name: $name, content: $content, ttl: 3600}')
  res=$(curl -sS -X POST "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records" \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" \
    -d "$payload" 2>/dev/null || true)
  success=$(printf '%s' "$res" | jq -r '.success // false' 2>/dev/null || true)

  if [[ "$success" == "true" ]]; then
    new_id=$(printf '%s' "$res" | jq -r '.result.id // empty' 2>/dev/null || true)
    say "  ${GREEN}✓ Published TXT ${full_name} → ${content} via Cloudflare API (id: ${new_id})${RESET}"
    return 0
  else
    warn "Could not publish via Cloudflare API: ${res}"
    return 1
  fi
}

banner "Thereish: Amazon SES & DNS wizard"

# ── Stage 1 ───────────────────────────────────────────────────────────────
stage "IAM identity & SES send credentials"
say "Create or capture an IAM user with SES send permissions (AmazonSESFullAccess"
say "or an inline policy granting ses:SendEmail, ses:SendRawEmail) and an Access Key."
say "Secrets are never printed on screen and never stored unencrypted on disk."
printf '\n'

open_url "https://${AWS_REGION}.console.aws.amazon.com/iam/home?region=${AWS_REGION}#/users"
step "In the AWS IAM Console, click 'Create user' (e.g. 'thereish-ses-mailer')."
step "Attach policies directly: AmazonSESFullAccess (or an inline policy with ses:SendEmail)."
step "Open the user -> 'Security credentials' -> 'Create access key' -> 'Application running outside AWS'."
step "Copy the Access Key ID and Secret Access Key."
printf '\n'

# If AWS CLI is present and already authenticated, show identity
if command -v aws >/dev/null 2>&1; then
  CALLER_ARN=$(aws sts get-caller-identity --query 'Arn' --output text 2>/dev/null || true)
  if [[ -n "$CALLER_ARN" ]]; then
    note "AWS CLI active identity: ${CALLER_ARN}"
  fi
fi

AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-${AWS_SES_ACCESS_KEY:-}}"
AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-${AWS_SES_SECRET_ACCESS_KEY:-}}"

if [[ -z "${AWS_ACCESS_KEY_ID:-}" ]]; then
  ask AWS_ACCESS_KEY_ID "AWS Access Key ID:"
else
  say "  ${GREEN}✓${RESET} AWS_ACCESS_KEY_ID from environment: ${AWS_ACCESS_KEY_ID}"
fi

if [[ -z "${AWS_SECRET_ACCESS_KEY:-}" ]]; then
  ask_secret AWS_SECRET_ACCESS_KEY "AWS Secret Access Key:"
else
  say "  ${GREEN}✓${RESET} AWS_SECRET_ACCESS_KEY provided in environment."
fi

if [[ -z "${AWS_REGION:-}" ]]; then
  ask AWS_REGION "AWS Region [default us-east-1]:"
  AWS_REGION="${AWS_REGION:-us-east-1}"
fi
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION

if [[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]]; then
  say "${GREEN}✓${RESET} IAM credentials captured in memory for region ${AWS_REGION}."
else
  warn "Missing AWS credentials. You can enter them now or on the server later."
fi
pause

# ── Stage 2 ───────────────────────────────────────────────────────────────
stage "SES domain identity for ${DOMAIN} & Easy DKIM"
say "Create the domain identity for ${DOMAIN} with Easy DKIM (2048-bit RSA)."
say "We will capture the three CNAME selectors to publish to DNS."
printf '\n'

open_url "https://${AWS_REGION}.console.aws.amazon.com/ses/home?region=${AWS_REGION}#/identities"
step "Click 'Create identity' -> choose 'Domain'."
step "Domain: enter '${DOMAIN}'."
step "Under Easy DKIM, ensure 'Easy DKIM' and 'RSA_2048_BIT' are selected."
step "Click 'Create identity' and view the 3 CNAME records generated."
printf '\n'

DKIM_TOKENS=()

# Try AWS CLI if available and credentials configured
if command -v aws >/dev/null 2>&1 && [[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]]; then
  say "Checking SES via AWS CLI..."
  CLI_DKIM=$(aws sesv2 get-email-identity --email-identity "${DOMAIN}" --region "${AWS_REGION}" 2>/dev/null || true)
  if [[ -z "$CLI_DKIM" ]]; then
    CLI_DKIM=$(aws sesv2 create-email-identity --email-identity "${DOMAIN}" \
      --dkim-signing-attributes NextSigningKeyLength=RSA_2048_BIT --region "${AWS_REGION}" 2>/dev/null || true)
  fi
  if [[ -n "$CLI_DKIM" ]] && command -v jq >/dev/null 2>&1; then
    while IFS= read -r token; do
      [[ -n "$token" ]] && DKIM_TOKENS+=("$token")
    done < <(printf '%s' "$CLI_DKIM" | jq -r '.DkimAttributes.Tokens[]? // empty')
    if (( ${#DKIM_TOKENS[@]} == 3 )); then
      say "${GREEN}✓ Read 3 Easy DKIM tokens from AWS CLI:${RESET}"
      for i in "${!DKIM_TOKENS[@]}"; do
        say "  $((i + 1)): ${DKIM_TOKENS[$i]}"
      done
    fi
  fi
fi

if (( ${#DKIM_TOKENS[@]} < 3 )); then
  say "Paste the three Easy DKIM tokens from the AWS Console."
  say "(In SES Console -> Identities -> ${DOMAIN} -> Easy DKIM -> CNAME records table."
  say "Copy the name string before ._domainkey, e.g. 'abcdef123456'):"
  printf '\n'
  DKIM_TOKEN_1="${DKIM_TOKEN_1:-}"
  DKIM_TOKEN_2="${DKIM_TOKEN_2:-}"
  DKIM_TOKEN_3="${DKIM_TOKEN_3:-}"

  while [[ -z "${DKIM_TOKEN_1}" ]]; do
    ask DKIM_TOKEN_1 "DKIM Token 1:"
    DKIM_TOKEN_1="${DKIM_TOKEN_1%%._domainkey*}"
    [[ -z "${DKIM_TOKEN_1}" ]] && warn "DKIM Token 1 cannot be empty."
  done
  while [[ -z "${DKIM_TOKEN_2}" ]]; do
    ask DKIM_TOKEN_2 "DKIM Token 2:"
    DKIM_TOKEN_2="${DKIM_TOKEN_2%%._domainkey*}"
    [[ -z "${DKIM_TOKEN_2}" ]] && warn "DKIM Token 2 cannot be empty."
  done
  while [[ -z "${DKIM_TOKEN_3}" ]]; do
    ask DKIM_TOKEN_3 "DKIM Token 3:"
    DKIM_TOKEN_3="${DKIM_TOKEN_3%%._domainkey*}"
    [[ -z "${DKIM_TOKEN_3}" ]] && warn "DKIM Token 3 cannot be empty."
  done
  DKIM_TOKENS=("${DKIM_TOKEN_1}" "${DKIM_TOKEN_2}" "${DKIM_TOKEN_3}")
fi

say "Easy DKIM CNAME records to publish on ${DOMAIN}:"
for token in "${DKIM_TOKENS[@]}"; do
  say "  ${token}._domainkey.${DOMAIN} → ${token}.dkim.amazonses.com"
done
pause

# ── Stage 3 ───────────────────────────────────────────────────────────────
stage "Custom MAIL FROM subdomain (${MAIL_FROM_SUBDOMAIN}.${DOMAIN})"
say "Configure a custom MAIL FROM domain so SPF aligns with ${DOMAIN}."
say "This requires an MX record and a TXT (SPF) record on ${MAIL_FROM_SUBDOMAIN}.${DOMAIN}."
printf '\n'

open_url "https://${AWS_REGION}.console.aws.amazon.com/ses/home?region=${AWS_REGION}#/identities/${DOMAIN}"
step "In SES -> Identities -> ${DOMAIN} -> 'Custom MAIL FROM domain', click 'Edit'."
step "Check 'Use a custom MAIL FROM domain'."
step "MAIL FROM domain: enter '${MAIL_FROM_SUBDOMAIN}' (resulting in ${MAIL_FROM_SUBDOMAIN}.${DOMAIN})."
step "Behavior on MX failure: select 'Reject message' (or default)."
step "Save changes."
printf '\n'

# Try AWS CLI if available
if command -v aws >/dev/null 2>&1 && [[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]]; then
  if aws sesv2 put-email-identity-mail-from-attributes \
      --email-identity "${DOMAIN}" \
      --mail-from-domain "${MAIL_FROM_SUBDOMAIN}.${DOMAIN}" \
      --behavior-on-mx-failure REJECT_MESSAGE \
      --region "${AWS_REGION}" 2>/dev/null; then
    say "${GREEN}✓ Set custom MAIL FROM attributes via AWS CLI.${RESET}"
  fi
fi

MAIL_FROM_MX="feedback-smtp.${AWS_REGION}.amazonses.com"
MAIL_FROM_TXT="v=spf1 include:amazonses.com ~all"

say "Read back and confirm custom MAIL FROM records for ${MAIL_FROM_SUBDOMAIN}.${DOMAIN}:"
ask MAIL_FROM_MX "MAIL FROM MX destination [default ${MAIL_FROM_MX}]:"
MAIL_FROM_MX="${MAIL_FROM_MX:-feedback-smtp.${AWS_REGION}.amazonses.com}"
MAIL_FROM_MX="${MAIL_FROM_MX#"${MAIL_FROM_MX%%[a-zA-Z]*}"}"
MAIL_FROM_MX="${MAIL_FROM_MX%.}"
ask MAIL_FROM_TXT "MAIL FROM TXT (SPF) [default ${MAIL_FROM_TXT}]:"
MAIL_FROM_TXT="${MAIL_FROM_TXT:-v=spf1 include:amazonses.com ~all}"

say "Records to publish for custom MAIL FROM on ${MAIL_FROM_SUBDOMAIN}.${DOMAIN}:"
say "  MX:  ${MAIL_FROM_SUBDOMAIN}.${DOMAIN} → ${MAIL_FROM_MX} (priority 10)"
say "  TXT: ${MAIL_FROM_SUBDOMAIN}.${DOMAIN} → ${MAIL_FROM_TXT}"
pause

# ── Stage 4 ───────────────────────────────────────────────────────────────
stage "DMARC policy & report-authorisation"
say "Publish _dmarc.${DOMAIN} at p=none with a rua= aggregate reporting address."
say "If the reporting address is on another domain, RFC 7489 / 9989 requires an"
say "external destination report-authorisation record on that domain."
printf '\n'

DMARC_RUA="${DMARC_RUA:-dmarc@stephens.page}"
ask DMARC_RUA "DMARC aggregate reporting address (rua) [default dmarc@stephens.page]:"
DMARC_RUA="${DMARC_RUA:-dmarc@stephens.page}"
DMARC_RUA_EMAIL="${DMARC_RUA#mailto:}"

# Extract reporting domain
REPORTING_DOMAIN="${DMARC_RUA_EMAIL##*@}"
DMARC_TXT="v=DMARC1; p=none; rua=mailto:${DMARC_RUA_EMAIL};"

say "DMARC record to publish on ${DOMAIN}:"
say "  TXT: _dmarc.${DOMAIN} → ${DMARC_TXT}"
printf '\n'

REPORT_AUTH_DOMAIN=""
REPORT_AUTH_SUBDOMAIN=""
REPORT_AUTH_RECORD=""

if [[ -n "$REPORTING_DOMAIN" && "$REPORTING_DOMAIN" != "$DOMAIN" ]]; then
  REPORT_AUTH_SUBDOMAIN="${DOMAIN}._report._dmarc"
  REPORT_AUTH_RECORD="v=DMARC1"
  say "Cross-domain report authorisation required on ${REPORTING_DOMAIN}:"
  say "  Record: TXT ${REPORT_AUTH_SUBDOMAIN}.${REPORTING_DOMAIN} → ${REPORT_AUTH_RECORD}"
  REPORT_AUTH_DOMAIN="${REPORTING_DOMAIN}"
fi
pause

# ── Stage 5 ───────────────────────────────────────────────────────────────
stage "Publish records via Porkbun DNS API"
say "Publish Easy DKIM, custom MAIL FROM, and DMARC records through Porkbun's API."
say "All records are published idempotently: re-runs detect existing records and move on."
printf '\n'

# Capture Porkbun API credentials
PORKBUN_API_KEY="${PORKBUN_API_KEY:-}"
PORKBUN_SECRET_API_KEY="${PORKBUN_SECRET_API_KEY:-${PORKBUN_SECRET_KEY:-}}"

if [[ -z "$PORKBUN_API_KEY" ]]; then
  ask PORKBUN_API_KEY "Porkbun API Key (pk1_...):"
fi
if [[ -z "$PORKBUN_SECRET_API_KEY" ]]; then
  ask_secret PORKBUN_SECRET_API_KEY "Porkbun Secret API Key (sk1_...):"
fi
export PORKBUN_API_KEY PORKBUN_SECRET_API_KEY

# Test Porkbun API connectivity
say "Testing Porkbun API credentials..."
PING_RES=$(porkbun_call "ping" "{}")
PING_STATUS=$(printf '%s' "$PING_RES" | grep -o '"status":"[^"]*"' | cut -d'"' -f4 || true)

if [[ "$PING_STATUS" != "SUCCESS" ]]; then
  warn "Could not authenticate with Porkbun API: ${PING_RES}"
  warn "Visit https://porkbun.com/account/api to verify API key and IP permissions."
  SKIPPED+=("Porkbun DNS automatic publishing (API ping failed)")
  pause "Continue anyway?"
else
  say "${GREEN}✓ Porkbun API authenticated.${RESET}"
  printf '\n'

  # Retrieve existing records for thereish.app
  say "Retrieving existing DNS records for ${DOMAIN}..."
  EXISTING_DOMAIN_RECORDS=$(porkbun_call "dns/retrieve/${DOMAIN}" "{}")

  # 1-3: Easy DKIM CNAMEs
  say "Publishing 3 Easy DKIM CNAMEs..."
  for token in "${DKIM_TOKENS[@]}"; do
    if [[ -z "$token" ]]; then
      warn "Skipping empty DKIM token"
      continue
    fi
    porkbun_publish_record_idempotent "${DOMAIN}" "${token}._domainkey" "CNAME" "${token}.dkim.amazonses.com" 0 "$EXISTING_DOMAIN_RECORDS"
  done

  # 4-5: MAIL FROM MX and TXT
  say "Publishing custom MAIL FROM records..."
  EXISTING_DOMAIN_RECORDS=$(porkbun_call "dns/retrieve/${DOMAIN}" "{}")
  porkbun_publish_record_idempotent "${DOMAIN}" "${MAIL_FROM_SUBDOMAIN}" "MX" "${MAIL_FROM_MX}" 10 "$EXISTING_DOMAIN_RECORDS" || true
  EXISTING_DOMAIN_RECORDS=$(porkbun_call "dns/retrieve/${DOMAIN}" "{}")
  porkbun_publish_record_idempotent "${DOMAIN}" "${MAIL_FROM_SUBDOMAIN}" "TXT" "${MAIL_FROM_TXT}" 0 "$EXISTING_DOMAIN_RECORDS" || true

  # 6: DMARC record
  say "Publishing DMARC record..."
  EXISTING_DOMAIN_RECORDS=$(porkbun_call "dns/retrieve/${DOMAIN}" "{}")
  porkbun_publish_record_idempotent "${DOMAIN}" "_dmarc" "TXT" "${DMARC_TXT}" 0 "$EXISTING_DOMAIN_RECORDS" || true

  # 7: Report-authorisation record on reporting domain
  if [[ -n "$REPORT_AUTH_DOMAIN" ]]; then
    printf '\n'
    say "Checking if reporting domain '${REPORT_AUTH_DOMAIN}' is managed at Porkbun..."
    REPORTING_RECORDS=$(porkbun_call "dns/retrieve/${REPORT_AUTH_DOMAIN}" "{}")
    reporting_domain_status=$(printf '%s' "$REPORTING_RECORDS" | grep -o '"status":"[^"]*"' | cut -d'"' -f4 || true)

    if [[ "$reporting_domain_status" == "SUCCESS" ]]; then
      say "${GREEN}✓ Reporting domain ${REPORT_AUTH_DOMAIN} found at Porkbun.${RESET}"
      say "Publishing report-authorisation record on ${REPORT_AUTH_DOMAIN}..."
      porkbun_publish_record_idempotent "${REPORT_AUTH_DOMAIN}" "${REPORT_AUTH_SUBDOMAIN}" "TXT" "${REPORT_AUTH_RECORD}" 0 "$REPORTING_RECORDS"
    elif cloudflare_publish_txt_idempotent "${REPORT_AUTH_DOMAIN}" "${REPORT_AUTH_SUBDOMAIN}" "${REPORT_AUTH_RECORD}"; then
      : # Successfully published or verified on Cloudflare
    else
      say "${YELLOW}Reporting domain ${REPORT_AUTH_DOMAIN} is not managed by Porkbun DNS.${RESET}"
      say "Publish the report-authorisation record by hand at ${REPORT_AUTH_DOMAIN}'s DNS provider:"
      step "Type:    TXT"
      step "Name:    ${REPORT_AUTH_SUBDOMAIN} (or ${REPORT_AUTH_SUBDOMAIN}.${REPORT_AUTH_DOMAIN})"
      step "Content: ${REPORT_AUTH_RECORD}"
      pause "Press Enter once noted or published by hand"
    fi
  fi
fi
pause

# ── Stage 6 ───────────────────────────────────────────────────────────────
stage "Identity verification check"
say "Amazon SES is checking DNS for Easy DKIM and Custom MAIL FROM."
say "DNS propagation typically takes 1 to 5 minutes."
printf '\n'

open_url "https://${AWS_REGION}.console.aws.amazon.com/ses/home?region=${AWS_REGION}#/identities/${DOMAIN}"

check_verification() {
  printf '\n'
  say "Querying public DNS with dig..."
  if command -v dig >/dev/null 2>&1; then
    for i in "${!DKIM_TOKENS[@]}"; do
      local token="${DKIM_TOKENS[$i]}"
      local dkim_res; dkim_res=$(dig +short CNAME "${token}._domainkey.${DOMAIN}" 2>/dev/null || true)
      if [[ -n "$dkim_res" ]]; then
        say "  ${GREEN}✓ DKIM CNAME $((i + 1)) resolves:${RESET} ${dkim_res}"
      else
        say "  ${YELLOW}· DKIM CNAME $((i + 1)) (${token}) not resolving yet${RESET}"
      fi
    done

    local mx_res; mx_res=$(dig +short MX "${MAIL_FROM_SUBDOMAIN}.${DOMAIN}" 2>/dev/null || true)
    local dmarc_res; dmarc_res=$(dig +short TXT "_dmarc.${DOMAIN}" 2>/dev/null || true)

    if [[ -n "$mx_res" ]]; then
      say "  ${GREEN}✓ MAIL FROM MX resolves:${RESET} ${mx_res}"
    else
      say "  ${YELLOW}· MAIL FROM MX not resolving yet${RESET}"
    fi

    if [[ -n "$dmarc_res" ]]; then
      say "  ${GREEN}✓ DMARC TXT resolves:${RESET} ${dmarc_res}"
    else
      say "  ${YELLOW}· DMARC TXT not resolving yet${RESET}"
    fi
  fi

  if command -v aws >/dev/null 2>&1 && [[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]]; then
    say "Querying AWS SES identity status..."
    local ses_identity; ses_identity=$(aws sesv2 get-email-identity --email-identity "${DOMAIN}" --region "${AWS_REGION}" 2>/dev/null || true)
    if [[ -n "$ses_identity" ]] && command -v jq >/dev/null 2>&1; then
      local dkim_status mail_from_status
      dkim_status=$(printf '%s' "$ses_identity" | jq -r '.DkimAttributes.Status // "UNKNOWN"')
      mail_from_status=$(printf '%s' "$ses_identity" | jq -r '.MailFromAttributes.MailFromDomainStatus // "UNKNOWN"')
      say "  AWS SES DKIM Status:      ${dkim_status}"
      say "  AWS SES MAIL FROM Status: ${mail_from_status}"
    fi
  fi
}

check_verification
while confirm "Check verification status again now?"; do
  check_verification
done
pause

# ── Stage 7 ───────────────────────────────────────────────────────────────
stage "Request SES production access"
say "Amazon SES starts in sandbox mode (can only send to verified addresses)."
say "Request production access so Thereish can send magic links and notices."
printf '\n'

USE_CASE_TEXT="Thereish (https://${DOMAIN}) is an online multiplayer party word game. We use Amazon SES exclusively for two low-volume transactional email flows:
1. Instant operator notifications when a new game room is created from a new device (a few messages per week).
2. Magic-link passwordless authentication emails sent immediately to players upon their explicit request to log in or claim their seat.

We do not send any marketing, promotional, or bulk emails. Recipients explicitly trigger every email. Bounce and complaint handling is monitored through SES suppression lists and configuration sets. We expect an initial volume of fewer than 50 emails per month, growing to a few thousand per month as active games increase."

# Copy to clipboard if pbcopy is available
if command -v pbcopy >/dev/null 2>&1; then
  printf '%s' "$USE_CASE_TEXT" | pbcopy
  say "${GREEN}✓ Copied use-case description to your clipboard!${RESET}"
fi

open_url "https://${AWS_REGION}.console.aws.amazon.com/ses/home?region=${AWS_REGION}#/account"
step "In SES Console -> Account dashboard, click 'Request production access'."
step "Mail type: select 'Transactional'."
step "Website URL: enter 'https://${DOMAIN}'."
step "Use case description: paste the text below (already in clipboard if on Mac):"
printf '\n%s%s%s\n\n' "$DIM" "$USE_CASE_TEXT" "$RESET"
step "Agree to AWS terms and submit the request."
printf '\n'

# If AWS CLI supports put-account-details, offer it
if command -v aws >/dev/null 2>&1 && [[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]]; then
  if confirm "Submit production access request via AWS CLI now?"; then
    if aws sesv2 put-account-details \
        --production-access-enabled \
        --mail-type TRANSACTIONAL \
        --website-url "https://${DOMAIN}" \
        --use-case-description "$USE_CASE_TEXT" \
        --region "${AWS_REGION}" 2>/dev/null; then
      say "${GREEN}✓ Submitted production access request via AWS CLI.${RESET}"
    else
      warn "AWS CLI submission failed; please submit via the console form opened above."
    fi
  fi
fi
pause

# ── Stage 8 ───────────────────────────────────────────────────────────────
stage "Push credentials and notice addresses to server"
say "Push AWS SES credentials and notice addresses to ${SERVER}."
say "Calls bin/keys-to-server, which upserts them into ${APP_DIR}/.env over SSH"
say "without printing secrets, then restarts the release container and verifies /check."
printf '\n'

NOTICE_TO="${NOTICE_TO:-jacob@stephens.page}"
NOTICE_FROM="${NOTICE_FROM:-notices@${DOMAIN}}"

ask NOTICE_TO "Recipient email for new-Room notices (NOTICE_TO) [default jacob@stephens.page]:"
NOTICE_TO="${NOTICE_TO:-jacob@stephens.page}"
ask NOTICE_FROM "Sender email for new-Room notices (NOTICE_FROM) [default notices@${DOMAIN}]:"
NOTICE_FROM="${NOTICE_FROM:-notices@${DOMAIN}}"

say "Values to push via bin/keys-to-server:"
say "  AWS_ACCESS_KEY_ID:     ${AWS_ACCESS_KEY_ID}"
say "  AWS_SECRET_ACCESS_KEY: (hidden in memory)"
say "  AWS_REGION:            ${AWS_REGION}"
say "  NOTICE_TO:             ${NOTICE_TO}"
say "  NOTICE_FROM:           ${NOTICE_FROM}"
printf '\n'

if confirm "Run bin/keys-to-server now to push these keys?"; then
  AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID}" \
  AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY}" \
  AWS_REGION="${AWS_REGION}" \
  NOTICE_TO="${NOTICE_TO}" \
  NOTICE_FROM="${NOTICE_FROM}" \
  "${SCRIPT_DIR}/keys-to-server"
else
  say "Skipped running bin/keys-to-server."
  say "You can run it manually anytime:"
  say "  va bash -c bin/keys-to-server"
fi

finish

#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

# Put the release's API keys on thereish.app.
#
#   va bash -c bin/keys-to-server        # the keys arrive in the environment
#   bin/keys-to-server                   # or paste each one when asked
#
# On 2026-09-06 the third playtest ran with no Mureka or Hume key on the server:
# every Page kept the house loop and every Verdict stayed silent, and only the
# logs said why (.scratch/foley/issues/07). This wizard reads the keys from the
# shell `va` gives it, shows which ones the server lacks, writes them into the
# server's .env, restarts the release, and walks through hearing the result.
# Values are never printed and never written anywhere on the Mac.

TOTAL_STAGES=5

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=deploy/env.sh
source "${SCRIPT_DIR}/../deploy/env.sh"
REMOTE_ENV="${APP_DIR}/.env"
COMPOSE="docker compose -f docker-compose.app.yml"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10 "${SERVER}")

# Every key the release reads that deploy/provision.sh cannot generate, in
# display order. Bash 3.2 on a stock Mac has no associative arrays, hence the
# case statement rather than a map.
KEYS=(GEMINI_API_KEY ANTHROPIC_API_KEY OPENAI_API_KEY MUREKA_API_KEY HUME_API_KEY HUME_SECRET_KEY ELEVENLABS_API_KEY AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION NOTICE_TO NOTICE_FROM)

buys() {
  case "$1" in
    GEMINI_API_KEY)        echo "the Assayer's verdicts, the Author's Flash arm, the Scribe's naming, Foley's ear" ;;
    ANTHROPIC_API_KEY)     echo "the Scribe's recaps" ;;
    OPENAI_API_KEY)        echo "the Author's Astra arm of the author_model experiment" ;;
    MUREKA_API_KEY)        echo "a Track for every Page (without it: the house loop only)" ;;
    HUME_API_KEY)          echo "the Assayer's voice (Hume Octave 2, the bake-off winner)" ;;
    HUME_SECRET_KEY)       echo "the Assayer's voice (Hume needs both keys)" ;;
    ELEVENLABS_API_KEY)    echo "the alternative voice, and the forge's effects" ;;
    AWS_ACCESS_KEY_ID)     echo "the notice when a new device creates a Room (Amazon SES)" ;;
    AWS_SECRET_ACCESS_KEY) echo "the notice when a new device creates a Room (Amazon SES)" ;;
    AWS_REGION)            echo "the AWS region for Amazon SES (us-east-1)" ;;
    NOTICE_TO)             echo "the recipient of the new-Room notice (operator's address)" ;;
    NOTICE_FROM)           echo "the sender of the new-Room notice (at thereish.app)" ;;
  esac
}

# value_of KEY prints the value of the shell variable named KEY, or nothing.
value_of() { eval "printf '%s' \"\${$1:-}\""; }

# in_list NEEDLE ITEM... succeeds when NEEDLE is one of the ITEMs.
in_list() {
  local needle="$1"; shift
  local item
  for item in "$@"; do [[ "$item" == "$needle" ]] && return 0; done
  return 1
}

banner "Thereish: the release's keys"

# ── Stage 1 ───────────────────────────────────────────────────────────────
stage "The keys in this shell"
say "Each key below is read from the environment. A shell started with"
say "'va bash' has all of them; any other shell has none, and you can paste"
say "the missing ones here (they stay in memory, nothing is written locally)."
printf '\n'
HAVE=()
for key in "${KEYS[@]}"; do
  if [[ -n "$(value_of "$key")" ]]; then
    printf '  %s✓%s %-20s %s%s%s\n' "$GREEN" "$RESET" "$key" "$DIM" "$(buys "$key")" "$RESET"
    HAVE+=("$key")
  else
    printf '  %s·%s %-20s %smissing here — %s%s\n' "$YELLOW" "$RESET" "$key" "$DIM" "$(buys "$key")" "$RESET"
  fi
done
printf '\n'
if (( ${#HAVE[@]} == 0 )); then
  warn "No keys in this shell. The easy way: Ctrl-C, then  va bash -c bin/keys-to-server"
fi
if (( ${#HAVE[@]} < ${#KEYS[@]} )); then
  if confirm "Paste the missing keys now? (Enter on a key skips it)"; then
    for key in "${KEYS[@]}"; do
      in_list "$key" "${HAVE[@]+"${HAVE[@]}"}" && continue
      ask_secret "$key" "$key:"
      [[ -n "$(value_of "$key")" ]] && HAVE+=("$key")
    done
  fi
fi
if (( ${#HAVE[@]} == 0 )); then
  warn "Nothing to push. Stopping."
  exit 1
fi
pause "Continue with ${#HAVE[@]} key(s)?"

# ── Stage 2 ───────────────────────────────────────────────────────────────
stage "What the server already has"
say "Reading the key names (never the values) in ${REMOTE_ENV} on ${SERVER}."
SERVER_HAS="$("${SSH[@]}" "sed -n 's/=.*//p' '${REMOTE_ENV}' | sort")" || {
  warn "Could not reach ${SERVER}. Is your ssh key loaded?"
  exit 1
}
printf '\n'
# shellcheck disable=SC2086
for name in $SERVER_HAS; do note "  ${name}"; done
printf '\n'
ADD=(); REPLACE=()
for key in "${HAVE[@]}"; do
  if printf '%s\n' "$SERVER_HAS" | grep -qx "$key"; then REPLACE+=("$key"); else ADD+=("$key"); fi
done
if (( ${#ADD[@]} )); then
  say "${BOLD}Missing on the server, will be added:${RESET} ${ADD[*]}"
else
  say "The server already has every key this shell has."
fi
PUSH=("${ADD[@]+"${ADD[@]}"}")
if (( ${#REPLACE[@]} )); then
  note "Already on the server (kept as they are unless you say so): ${REPLACE[*]}"
  if confirm "Also overwrite those ${#REPLACE[@]} with this shell's values?"; then
    PUSH+=("${REPLACE[@]}")
  fi
fi
if (( ${#PUSH[@]} == 0 )); then
  say "Nothing to write. Skipping to the restart in case the server was never restarted after a change."
else
  pause "Will write: ${PUSH[*]}. Continue?"
fi

# ── Stage 3 ───────────────────────────────────────────────────────────────
stage "Write them into the server's .env"
if (( ${#PUSH[@]} == 0 )); then
  say "Nothing to write."
else
  say "The values travel over ssh's stdin — never on a command line, never in"
  say "a log. The server upserts each KEY= line and keeps the file at mode 600."
  if ! confirm "Write ${#PUSH[@]} key(s) to ${REMOTE_ENV}?"; then
    warn "Not written. Stopping."
    exit 1
  fi
  # The remote script carries only the path, so it may ride in the command;
  # base64 keeps the quoting honest through the login shell.
  REMOTE_SCRIPT=$(cat <<REMOTE
set -euo pipefail
f='${REMOTE_ENV}'
tmp=\$(mktemp "\${f}.XXXXXX")
cp "\$f" "\$tmp"
count=0
while IFS= read -r line; do
  [ -z "\$line" ] && continue
  k=\${line%%=*}
  case "\$k" in ""|*[!A-Z0-9_]*) echo "refusing odd key name" >&2; rm -f "\$tmp"; exit 1;; esac
  grep -v "^\${k}=" "\$tmp" > "\$tmp.new" || true
  printf '%s\n' "\$line" >> "\$tmp.new"
  mv "\$tmp.new" "\$tmp"
  count=\$((count + 1))
done
chmod 600 "\$tmp"
mv "\$tmp" "\$f"
echo "wrote \$count key(s)"
echo "--- key names now in \$f:"
sed -n 's/=.*//p' "\$f" | sort
REMOTE
)
  B64=$(printf '%s\n' "$REMOTE_SCRIPT" | base64 | tr -d '\n')
  {
    for key in "${PUSH[@]}"; do printf '%s=%s\n' "$key" "$(value_of "$key")"; done
  } | "${SSH[@]}" "bash -c \"\$(echo ${B64} | base64 -d)\""
  for key in "${PUSH[@]}"; do WRITTEN_ENV+=("$key"); done
  printf '  %s✓ written%s to %s:%s\n' "$GREEN" "$RESET" "$SERVER" "$REMOTE_ENV"
fi
pause

# ── Stage 4 ───────────────────────────────────────────────────────────────
stage "Restart the release"
say "docker compose reads .env only when it creates the container, so it is"
say "recreated now. A 502 for a few seconds is normal."
if confirm "Recreate the app container on ${HOST}?"; then
  "${SSH[@]}" "cd '${APP_DIR}' && ${COMPOSE} up -d --force-recreate app" || {
    warn "The restart failed; see docs/deploy.md, Operating."
    exit 1
  }
  printf '  waiting for https://%s/check ' "$HOST"
  UP=0
  for _ in $(seq 1 30); do
    if curl -fs --max-time 5 "https://${HOST}/check" | grep -q 'data-check="socket"'; then UP=1; break; fi
    printf '.'
    sleep 2
  done
  printf '\n'
  if (( UP )); then
    printf '  %s✓ live%s https://%s/\n' "$GREEN" "$RESET" "$HOST"
  else
    warn "Not answering after a minute. Check: ${COMPOSE} logs --tail=100 app"
    SKIPPED+=("the release did not answer on /check after the restart")
  fi
  say "Anything the release complained about since the restart:"
  COMPLAINTS="$("${SSH[@]}" "cd '${APP_DIR}' && ${COMPOSE} logs --since 2m app 2>/dev/null | grep -iE 'not set|no_api_key|\[error\]' | tail -20" || true)"
  if [[ -n "$COMPLAINTS" ]]; then
    printf '%s\n' "$COMPLAINTS" | sed 's/^/    /'
  else
    note "  nothing — no missing-key or error lines in the log"
  fi
else
  SKIPPED+=("restart the release so it reads the new keys (docs/deploy.md, Operating)")
fi
pause

# ── Stage 5 ───────────────────────────────────────────────────────────────
stage "Hear it"
say "The only test that counts is the one on the couch. Two phones or one,"
say "and the laptop as the Stage:"
open_url "https://${HOST}/"
step "New Room on a phone; join by name. On the laptop open the same Code and tap 'Make this device the Stage', then 'Tap for sound', and tick Voice."
step "Give a setting each and play a Page. Within about a minute of the Bookends the house loop should hand over to a Track written for your settings."
step "At the reveal, the band word and the quip should be spoken after the sting."
if confirm "Did a Track fade in over the house loop?"; then
  note "  tick the second box on .scratch/foley/issues/07-foleys-keys-on-the-server.md"
else
  SKIPPED+=("no Track heard — read: ${COMPOSE} logs app | grep -i 'foley score'")
fi
if confirm "Was the Verdict spoken?"; then
  note "  tick the third box on .scratch/foley/issues/07-foleys-keys-on-the-server.md"
else
  SKIPPED+=("no voice heard — read: ${COMPOSE} logs app | grep -i 'voice synthesis'")
fi
open_url "https://${HOST}/spend"
step "The spend page should now show a Foley line beside the Author, the Assayer and the Scribe."
if confirm "Is Foley on the spend page?"; then
  note "  tick the fourth box on .scratch/foley/issues/07-foleys-keys-on-the-server.md"
else
  SKIPPED+=("no Foley line on /spend — the Track or the voice never landed")
fi

finish
